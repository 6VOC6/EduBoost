@model EduBoost.Models.Curso

@{
    ViewData["Title"] = "Eliminar Curso";
}

<div class="container py-5 animate-fade-in-up">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="glass-card p-5 border-0 shadow-lg text-center">
                <div class="bg-danger bg-opacity-10 text-danger rounded-circle p-4 d-inline-flex mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="bi bi-exclamation-triangle-fill" viewBox="0 0 16 16">
                        <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
                    </svg>
                </div>
                
                <h2 class="fw-bold mb-3">¿Eliminar este curso?</h2>
                <p class="text-muted mb-5 fs-5">
                    Estás a punto de eliminar <strong>"@Model.Nombre"</strong>. Esta acción es permanente y eliminará todas las inscripciones asociadas.
                </p>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="IdCurso" />
                    <div class="d-grid gap-3">
                        <button type="submit" class="btn btn-danger rounded-pill py-3 fw-bold shadow-sm">Sí, Eliminar Curso</button>
                        <a asp-action="Index" class="btn btn-glass rounded-pill py-3 fw-bold">Cancelar y Volver</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
