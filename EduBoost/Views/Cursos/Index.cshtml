@model IEnumerable<EduBoost.Models.Curso>

@{
    ViewData["Title"] = "Explorar Cursos";
}

<div class="container py-5 animate-fade-in-up">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 class="display-4 fw-bold text-gradient">Nuestros Cursos</h1>
            <p class="text-muted fs-5">Encuentra el apoyo académico que necesitas para potenciar tu aprendizaje.</p>
        </div>
        @if (User.IsInRole("Administrador") || User.IsInRole("Asesor"))
        {
            <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-plus-lg me-2" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2Z"/>
                </svg>
                Nuevo Curso
            </a>
        }
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card glass-card course-card h-100 border-0">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="course-icon-wrapper mb-3">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-book-half" viewBox="0 0 16 16">
                                <path d="M8.5 2.687c.654-.689 1.782-.886 3.112-.752 1.234.124 2.503.523 3.388.893v9.923c-.918-.35-2.107-.692-3.287-.81-1.094-.111-2.278-.039-3.213.492V2.687zM8 1.783C7.015.936 5.587.81 4.287.94c-1.514.153-3.042.672-3.994 1.105A.5.5 0 0 0 0 2.5v11a.5.5 0 0 0 .707.455c.882-.4 2.303-.881 3.68-1.02 1.409-.142 2.59.087 3.223.877a.5.5 0 0 0 .78 0c.633-.79 1.814-1.019 3.222-.877 1.378.139 2.8.62 3.681 1.02A.5.5 0 0 0 16 13.5v-11a.5.5 0 0 0-.293-.455c-.952-.433-2.48-.952-3.994-1.105C10.413.809 8.985.936 8 1.783z"/>
                            </svg>
                        </div>
                        <h3 class="card-title h4 fw-bold mb-3">@item.Nombre</h3>
                        <p class="card-text text-muted mb-4 line-clamp-3">
                            @item.Descripcion
                        </p>
                        <div class="mt-auto">
                            <div class="d-flex align-items-center mb-3 text-muted">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-person-fill me-2" viewBox="0 0 16 16">
                                    <path d="M3 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1H3Zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"/>
                                </svg>
                                <small>Prof. @item.Profesor</small>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <a asp-action="Details" asp-route-id="@item.IdCurso" class="btn btn-glass rounded-pill px-4 btn-sm fw-semibold">Ver Detalles</a>
                                @if (User.IsInRole("Administrador") || User.IsInRole("Asesor"))
                                {
                                    <div class="dropdown">
                                        <button class="btn btn-link text-muted p-0 shadow-none" type="button" data-bs-toggle="dropdown">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-three-dots-vertical" viewBox="0 0 16 16">
                                                <path d="M9.5 13a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0zm0-5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0zm0-5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0z"/>
                                            </svg>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end glass-card border-0 shadow-lg p-2">
                                            <li><a class="dropdown-item rounded-3 mb-1" asp-action="Edit" asp-route-id="@item.IdCurso">Editar</a></li>
                                            <li><a class="dropdown-item rounded-3 text-danger" asp-action="Delete" asp-route-id="@item.IdCurso">Eliminar</a></li>
                                        </ul>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .line-clamp-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;  
        overflow: hidden;
    }
</style>
