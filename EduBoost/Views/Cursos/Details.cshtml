@model EduBoost.Models.Curso
@{
    ViewData["Title"] = Model.Nombre;
    bool esDuenio = ViewBag.EsDuenio ?? false;
    bool estaInscrito = ViewBag.EstaInscrito ?? false;
}

<div class="container py-5 animate-fade-in-up">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-primary fw-medium">Cursos</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Nombre</li>
        </ol>
    </nav>

    <div class="row g-5">
        <div class="col-lg-8">
            <div class="glass-card p-5 mb-5 border-0">
                <div class="course-icon-wrapper mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-mortarboard-fill" viewBox="0 0 16 16">
                        <path d="M8.211 2.047a.5.5 0 0 0-.422 0l-7.135 3.547a.5.5 0 0 0 0 .896L3.14 7.844v2.523c0 2.12 1.959 3.515 4.86 3.515s4.86-1.395 4.86-3.515V7.844l2.466-1.354a.5.5 0 0 0 0-.896L8.211 2.047z"/>
                        <path d="M4.146 8.265 8 10.382l3.854-2.117L8 6.147 4.146 8.265z"/>
                    </svg>
                </div>
                <h1 class="display-5 fw-bold text-gradient mb-3">@Model.Nombre</h1>
                <p class="fs-5 text-muted mb-4">@Model.Descripcion</p>
                
                @if (esDuenio)
                {
                    <div class="mt-5 pt-4">
                        <h3 class="fw-bold mb-4 d-flex align-items-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-gear-fill me-2 text-primary" viewBox="0 0 16 16">
                              <path d="M9.405 1.05c-.413-.957-1.712-.957-2.125 0l-.417.969a1.54 1.54 0 0 1-1.459.991l-1.048-.01c-1.07-.01-1.933.853-1.923 1.923l.01 1.048a1.54 1.54 0 0 1-.991 1.459l-.969.417c-.957.413-.957 1.712 0 2.125l.969.417c.59.252.991.823.991 1.459l-.01 1.048c-.01 1.07.853 1.933 1.923 1.923l1.048-.01a1.54 1.54 0 0 1 1.459.991l.417.969c.413.957 1.712.957 2.125 0l.417-.969a1.54 1.54 0 0 1 1.459-.991l1.048.01c1.07.01 1.933-.853 1.923-1.923l-.01-1.048a1.54 1.54 0 0 1 .991-1.459l.969-.417c.957-.413.957-1.712 0-2.125l-.969-.417a1.54 1.54 0 0 1-.991-1.459l.01-1.048c.01-1.07-.853-1.933-1.923-1.923l-1.048.01a1.54 1.54 0 0 1-1.459-.991l-.417-.969zM8 10.93a2.929 2.929 0 1 1 0-5.86 2.929 2.929 0 0 1 0 5.858z"/>
                            </svg>
                            Gestión de Materiales
                        </h3>
                        
                        <div class="bg-light p-4 rounded-4 mb-4">
                            <h6 class="fw-bold mb-3">Agregar nuevo material</h6>
                            <form asp-action="AgregarMaterial" method="post" class="row g-3">
                                <input type="hidden" name="idCurso" value="@Model.IdCurso" />
                                <div class="col-md-6">
                                    <input type="text" name="titulo" class="form-control rounded-pill" placeholder="Título del material" required />
                                </div>
                                <div class="col-md-3">
                                    <select name="tipo" class="form-select rounded-pill">
                                        <option value="Video">Video</option>
                                        <option value="Lectura">Lectura</option>
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <button type="submit" class="btn btn-primary w-100 rounded-pill">Agregar</button>
                                </div>
                                <div class="col-12">
                                    <input type="url" name="url" class="form-control rounded-pill" placeholder="URL del video (YouTube)" />
                                    <div class="form-text small px-2">Solo necesario si es un video.</div>
                                </div>
                            </form>
                        </div>

                        <div class="list-group list-group-flush">
                            @if (Model.Materiales.Any())
                            {
                                @foreach (var m in Model.Materiales)
                                {
                                    <div class="list-group-item d-flex justify-content-between align-items-center bg-transparent border-0 px-0 mb-2">
                                        <div class="d-flex align-items-center">
                                            <div class="bg-primary bg-opacity-10 text-primary p-2 rounded-circle me-3">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi @(m.TipoMaterial == "Video" ? "bi-play-fill" : "bi-file-text-fill")" viewBox="0 0 16 16">
                                                  @if(m.TipoMaterial == "Video"){ <path d="m11.596 8.697-6.363 3.692c-.54.313-1.233-.066-1.233-.697V4.308c0-.63.692-1.01 1.233-.696l6.363 3.692a.802.802 0 0 1 0 1.393z"/> }
                                                  else { <path d="M5 4a.5.5 0 0 0 0 1h6a.5.5 0 0 0 0-1H5zm-.5 2.5A.5.5 0 0 1 5 6h6a.5.5 0 0 1 0 1H5a.5.5 0 0 1-.5-.5zM5 8a.5.5 0 0 0 0 1h6a.5.5 0 0 0 0-1H5zm0 2a.5.5 0 0 0 0 1h3a.5.5 0 0 0 0-1H5z"/> <path d="M2 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2zm10-1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1z"/> }
                                                </svg>
                                            </div>
                                            <div>
                                                <h6 class="mb-0 fw-bold">@m.Titulo</h6>
                                                <small class="text-muted">@m.TipoMaterial</small>
                                            </div>
                                        </div>
                                        <form asp-action="EliminarMaterial" method="post" onsubmit="return confirm('¿Seguro que quieres eliminar este material?')">
                                            <input type="hidden" name="id" value="@m.IdMaterial" />
                                            <button type="submit" class="btn btn-link text-danger p-0">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-trash-fill" viewBox="0 0 16 16">
                                                  <path d="M2.5 1a1 1 0 0 0-1 1v1a1 1 0 0 0 1 1H3v9a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V4h.5a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H10a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1H2.5zm3 4a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 .5-.5zM8 5a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7A.5.5 0 0 1 8 5zm3 .5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 1 0z"/>
                                                </svg>
                                            </button>
                                        </form>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted small">No hay materiales aún.</p>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <hr class="my-5 opacity-25">
                    <h3 class="fw-bold mb-4">¿Qué aprenderás?</h3>
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="d-flex align-items-start">
                                <div class="bg-success bg-opacity-10 text-success rounded-circle p-2 me-3">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-check2" viewBox="0 0 16 16">
                                        <path d="M13.854 3.646a.5.5 0 0 1 0 .708l-7 7a.5.5 0 0 1-.708 0l-3.5-3.5a.5.5 0 1 1 .708-.708L6.5 10.293l6.646-6.647a.5.5 0 0 1 .708 0z"/>
                                    </svg>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-1">Fundamentos Sólidos</h6>
                                    <p class="small text-muted mb-0">Domina los conceptos base de la materia.</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-start">
                                <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-2 me-3">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-play-circle-fill" viewBox="0 0 16 16">
                                        <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM6.79 5.093A.5.5 0 0 0 6 5.5v5a.5.5 0 0 0 .79.407l3.5-2.5a.5.5 0 0 0 0-.814l-3.5-2.5z"/>
                                    </svg>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-1">Contenido Multimedia</h6>
                                    <p class="small text-muted mb-0">Videos y material interactivo.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-4">
            <div class="glass-card p-4 border-0 mb-4 sticky-top" style="top: 100px;">
                <div class="d-flex align-items-center mb-4">
                    <img src="https://ui-avatars.com/api/?name=@(Model.Profesor?.Replace(" ", "+"))&background=4F46E5&color=fff&size=128" 
                         class="rounded-circle me-3" width="56" alt="Instructor">
                    <div>
                        <h6 class="fw-bold mb-0">@Model.Profesor</h6>
                        <small class="text-muted">Instructor del curso</small>
                    </div>
                </div>
                
                <div class="mb-4">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Fecha de creación:</span>
                        <span class="fw-medium">@Model.FechaCreacion.ToString("dd MMM yyyy")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Nivel:</span>
                        <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3">Intermedio</span>
                    </div>
                </div>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    @if (esDuenio)
                    {
                        <div class="alert alert-info glass-card border-0 d-flex align-items-center mb-3">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-info-circle-fill me-2" viewBox="0 0 16 16">
                                <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2z"/>
                            </svg>
                            <span class="fw-bold">Eres el asesor</span>
                        </div>
                        <a asp-action="VerContenido" asp-route-id="@Model.IdCurso" class="btn btn-primary w-100 rounded-pill py-3 fw-bold mb-3">Previsualizar Contenido</a>
                    }
                    else if (estaInscrito)
                    {
                        <div class="alert alert-success glass-card border-0 d-flex align-items-center mb-3">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-check-circle-fill me-2" viewBox="0 0 16 16">
                                <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
                            </svg>
                            <span class="fw-bold">Ya estás inscrito</span>
                        </div>
                        <a asp-action="VerContenido" asp-route-id="@Model.IdCurso" class="btn btn-outline-primary w-100 rounded-pill py-3 fw-bold mb-3">Ver Contenido</a>
                    }
                    else
                    {
                        <form asp-action="Inscribirse" asp-route-id="@Model.IdCurso" method="post">
                            <button type="submit" class="btn btn-primary w-100 rounded-pill py-3 fw-bold mb-3">Inscribirme ahora</button>
                        </form>
                        <p class="text-center small text-muted mb-0">¡Únete a más de 500 estudiantes!</p>
                    }
                }
                else
                {
                    <a asp-controller="Usuarios" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="btn btn-primary w-100 rounded-pill py-3 fw-bold mb-3">Inicia sesión para inscribirte</a>
                }
            </div>
        </div>
    </div>
</div>
