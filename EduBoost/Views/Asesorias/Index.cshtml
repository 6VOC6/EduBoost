@model IEnumerable<EduBoost.Models.Asesoria>
@using System.Security.Claims
@{
    ViewData["Title"] = "Mis Asesorías";
    var rol = User.FindFirstValue(ClaimTypes.Role);
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-5 animate-fade-in-up">
        <div>
            <h1 class="display-5 fw-bold text-gradient mb-2">Mis Asesorías</h1>
            <p class="text-muted">Gestiona tus sesiones de apoyo académico personalizado.</p>
        </div>
        @if (rol == "Estudiante")
        {
            <a asp-action="Solicitar" class="btn btn-primary rounded-pill px-4 shadow">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-plus-circle-fill me-2" viewBox="0 0 16 16">
                  <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM8.5 4.5a.5.5 0 0 0-1 0v3h-3a.5.5 0 0 0 0 1h3v3a.5.5 0 0 0 1 0v-3h3a.5.5 0 0 0 0-1h-3v-3z"/>
                </svg>
                Solicitar Asesoría
            </a>
        }
    </div>

    <div class="row g-4 animate-fade-in-up" style="animation-delay: 0.1s;">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <div class="glass-card p-5 d-inline-block">
                    <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="bi bi-calendar-x text-muted mb-4" viewBox="0 0 16 16">
                      <path d="M6.146 7.146a.5.5 0 0 1 .708 0L8 8.293l1.146-1.147a.5.5 0 1 1 .708.708L8.707 9l1.147 1.146a.5.5 0 0 1-.708.708L8 9.707l-1.146 1.147a.5.5 0 0 1-.708-.708L7.293 9 6.146 7.854a.5.5 0 0 1 0-.708z"/>
                      <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5zM1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4H1z"/>
                    </svg>
                    <h3>No tienes asesorías programadas</h3>
                    <p class="text-muted mb-4">Solicita apoyo personalizado para mejorar en tus cursos.</p>
                </div>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="glass-card h-100 p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <span class="badge rounded-pill @(item.Estado switch {
                                "Pendiente" => "bg-warning text-dark",
                                "Aceptada" => "bg-info text-white",
                                "Completada" => "bg-success text-white",
                                _ => "bg-secondary text-white"
                            }) px-3 py-2">
                                @item.Estado
                            </span>
                            <small class="text-muted fw-bold">
                                @item.FechaHora.ToString("dd MMM, HH:mm")
                            </small>
                        </div>

                        <h5 class="fw-bold mb-1">@item.Curso?.Nombre</h5>
                        <p class="text-primary small mb-3">Tema: @item.Tema</p>
                        
                        <hr class="opacity-10 my-3">

                        <div class="d-flex align-items-center mb-4">
                            <div class="flex-shrink-0">
                                <div class="bg-light rounded-circle p-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-person-circle text-muted" viewBox="0 0 16 16">
                                      <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"/>
                                      <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8zm8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1z"/>
                                    </svg>
                                </div>
                            </div>
                            <div class="ms-3">
                                @if (rol == "Estudiante")
                                {
                                    <p class="mb-0 small text-muted">Asesor:</p>
                                    <p class="mb-0 fw-semibold">@(item.Asesor?.Nombre ?? "Por asignar...")</p>
                                }
                                else
                                {
                                    <p class="mb-0 small text-muted">Estudiante:</p>
                                    <p class="mb-0 fw-semibold">@item.Estudiante?.Nombre</p>
                                }
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(item.EnlaceReunion) && item.Estado == "Aceptada")
                        {
                            <a href="@item.EnlaceReunion" target="_blank" class="btn btn-outline-primary w-100 rounded-pill mb-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-camera-video-fill me-2" viewBox="0 0 16 16">
                                  <path fill-rule="evenodd" d="M0 5a2 2 0 0 1 2-2h7.5a2 2 0 0 1 1.983 1.738l3.11-1.382A1 1 0 0 1 16 4.269v7.462a1 1 0 0 1-1.406.913l-3.111-1.382A2 2 0 0 1 9.5 13H2a2 2 0 0 1-2-2V5z"/>
                                </svg>
                                Unirse a la sesión
                            </a>
                        }

                        @if (rol != "Estudiante" && item.Estado == "Pendiente")
                        {
                            <a asp-action="Gestionar" asp-route-id="@item.IdAsesoria" class="btn btn-primary w-100 rounded-pill">
                                Gestionar Solicitud
                            </a>
                        }
                        else if (rol != "Estudiante" && item.Estado == "Aceptada")
                        {
                             <form asp-action="Finalizar" method="post">
                                <input type="hidden" name="id" value="@item.IdAsesoria" />
                                <button type="submit" class="btn btn-success w-100 rounded-pill">Marcar como Completada</button>
                            </form>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>
