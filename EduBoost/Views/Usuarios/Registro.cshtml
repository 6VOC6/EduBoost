@model Usuario

<h2>Registro de Usuario</h2>

<form asp-action="Registro" method="post">

    <div>
        <label>Nombre</label>
        <input asp-for="Nombre" />
    </div>

    <div>
        <label>Correo</label>
        <input asp-for="Correo" />
    </div>

    <div>
        <label>Password</label>
        <input asp-for="Password" type="password" />
    </div>

    <div>
        <label>Rol</label>
        <input asp-for="Rol" />
    </div>

    <button type="submit">Registrarse</button>

</form>