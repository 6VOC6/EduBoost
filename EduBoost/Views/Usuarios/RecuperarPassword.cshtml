@model EduBoost.Models.RecuperarPasswordViewModel
@{
    ViewData["Title"] = "Recuperar Contraseña";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card glass-card shadow-sm border-0">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <i class="bi bi-shield-lock text-primary display-4 mb-3"></i>
                        <h2 class="fw-bold">Recuperar Contraseña</h2>
                        <p class="text-muted">Ingresa tu correo electrónico y te enviaremos un enlace para restablecer tu contraseña.</p>
                    </div>

                    <form asp-action="RecuperarPassword" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="form-floating mb-4">
                            <input asp-for="Correo" class="form-control" placeholder="nombre@ejemplo.com" />
                            <label asp-for="Correo"><i class="bi bi-envelope me-2"></i>Correo Electrónico</label>
                            <span asp-validation-for="Correo" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold shadow-sm mb-3">
                            Enviar Enlace de Recuperación
                        </button>
                        
                        <div class="text-center">
                            <a asp-action="Login" class="text-decoration-none">Volver al inicio de sesión</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
